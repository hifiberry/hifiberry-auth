#!/bin/sh
set -e
case "$1" in
  configure)
    if ! getent passwd _hifiauth >/dev/null; then
      adduser --system --group --no-create-home --home /var/lib/hifiberry-auth _hifiauth
    fi
    mkdir -p /var/lib/hifiberry-auth
    chown _hifiauth:_hifiauth /var/lib/hifiberry-auth
    chmod 0750 /var/lib/hifiberry-auth
    mkdir -p /etc/hifiberry/auth.d
    # nginx picks up the new snippets on reload; do it if nginx is running
    if [ -d /run/systemd/system ] && systemctl is-active --quiet nginx 2>/dev/null; then
      systemctl reload nginx || true
    fi
    ;;

  triggered)
    # A package added, changed or removed a classification manifest in
    # /etc/hifiberry/auth.d. Manifests are read at startup only, so without
    # this the gateway keeps its old view of the world. On a fresh install
    # that is fatal: hifiberry-auth is pulled in as a dependency and starts
    # before configurator and audiocontrol ship their manifests, so every
    # endpoint falls through to the risky default and the whole web UI 401s.
    # try-restart is a no-op while the service is not running yet.
    if [ -d /run/systemd/system ]; then
      systemctl try-restart hifiberry-auth.service || true
    fi
    ;;
esac
#DEBHELPER#
exit 0
